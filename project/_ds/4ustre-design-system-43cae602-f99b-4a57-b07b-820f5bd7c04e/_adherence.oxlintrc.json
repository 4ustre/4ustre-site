{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/cards/**",
              "components/core/**",
              "components/layout/**",
              "components/media/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Instrument Serif|Hanken Grotesk))/i]",
        "message": "Font not provided by the design system. Available: Instrument Serif, Hanken Grotesk."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|as|disabled|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, as, disabled, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|onField)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'onField'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:small|medium|large)$/]",
        "message": "<Button> size must be one of 'small' | 'medium' | 'large'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|a)$/]",
        "message": "<Button> as must be one of 'button' | 'a'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Caption'] > JSXAttribute > JSXIdentifier[name!=/^(?:credit|tone|children|key|ref|className|style|children)$/]",
        "message": "<Caption> doesn't accept that prop. Declared props: credit, tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Caption'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:paper|field)$/]",
        "message": "<Caption> tone must be one of 'paper' | 'field'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ColorField'] > JSXAttribute > JSXIdentifier[name!=/^(?:section|circle|pad|children|key|ref|className|style|children)$/]",
        "message": "<ColorField> doesn't accept that prop. Declared props: section, circle, pad, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ColorField'] > JSXAttribute[name.name='section'] > Literal[value!=/^(?:rose|grass|plum|sage|cornflower|terracotta|marigold|poppy|ink)$/]",
        "message": "<ColorField> section must be one of 'rose' | 'grass' | 'plum' | 'sage' | 'cornflower' | 'terracotta' | 'marigold' | 'poppy' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ImageFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|shape|ratio|fill|grain|caption|credit|bleed|key|ref|className|style|children)$/]",
        "message": "<ImageFrame> doesn't accept that prop. Declared props: src, alt, shape, ratio, fill, grain, caption, credit, bleed."
      },
      {
        "selector": "JSXOpeningElement[name.name='ImageFrame'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:rect|circle)$/]",
        "message": "<ImageFrame> shape must be one of 'rect' | 'circle'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ImageFrame'] > JSXAttribute[name.name='grain'] > Literal[value!=/^(?:paper|field)$/]",
        "message": "<ImageFrame> grain must be one of 'paper' | 'field'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ImageFrame'] > JSXAttribute[name.name='bleed'] > Literal[value!=/^(?:none|left|right)$/]",
        "message": "<ImageFrame> bleed must be one of 'none' | 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Label'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|rule|as|children|key|ref|className|style|children)$/]",
        "message": "<Label> doesn't accept that prop. Declared props: tone, rule, as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Label'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:muted|ink|accent|field)$/]",
        "message": "<Label> tone must be one of 'muted' | 'ink' | 'accent' | 'field'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|tone|clearspace|title|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: variant, size, tone, clearspace, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:mark|lockup|stamp)$/]",
        "message": "<Logo> variant must be one of 'mark' | 'lockup' | 'stamp'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProjectCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|meta|src|alt|shape|ratio|fill|href|key|ref|className|style|children)$/]",
        "message": "<ProjectCard> doesn't accept that prop. Declared props: title, meta, src, alt, shape, ratio, fill, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProjectCard'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:rect|circle)$/]",
        "message": "<ProjectCard> shape must be one of 'rect' | 'circle'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:outline|quiet|field|accent)$/]",
        "message": "<Tag> tone must be one of 'outline' | 'quiet' | 'field' | 'accent'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
